# Copy to .env and fill in. Never commit .env.

# Which LLM answers the coach: gemini | gemma
LLM_PROVIDER=gemini

# Gemini (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=

# Gemma via an OpenAI-compatible endpoint: vLLM in a Verda Serverless Container (Verda's managed inference has no Gemma)
# Hugging Face token with the Gemma licence accepted (used when deploying the container, not by the app)
HF_TOKEN=
# Stage 1: leave BASE_URL empty -> Gemma runs through the Gemini API with GEMINI_API_KEY
GEMMA_MODEL=gemma-4-26b-a4b-it
# Stage 2: vLLM endpoint on Verda (fill in after deploying)
GEMMA_BASE_URL=
GEMMA_API_KEY=

# Exa (Butler)
EXA_API_KEY=

# App
DEMO_CUSTOMER_ID=
# "Today" for time-relative metrics (YYYY-MM-DD). Empty = latest date in the dataset.
DEMO_TODAY=
DATA_DIR=../data
